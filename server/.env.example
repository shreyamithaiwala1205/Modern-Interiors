# ==============================================================================
# Modern Interiors - Server Environment Configuration Template
# Copy this file to .env and fill in your actual credentials before starting.
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/moderninteriors?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway Credentials (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP Email Configuration (Nodemailer / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Brevo (Order Confirmation / Status Update Emails)
# Use a verified sender from Brevo -> Settings -> Senders
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME="Modern Interiors"
BREVO_REPLY_EMAIL=your_verified_sender@example.com
BREVO_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=admin_notification_email@example.com
